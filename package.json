{
  "name": "pan-tilt-controller-dashboard",
  "version": "1.0.0",
  "description": "Dual-Axis Pan-Tilt (Alt-Azimuth) Stepper Controller Dashboard & Firmware",
  "scripts": {
    "start": "python3 -m http.server 8080 --directory dashboard",
    "build:firmware": "mkdir -p build && arduino-builder -compile -hardware /usr/share/arduino/hardware -tools /usr/bin -fqbn arduino:avr:uno -build-path $(pwd)/build $(pwd)/firmware/PanTiltController/PanTiltController.ino",
    "flash": "avrdude -v -patmega328p -carduino -P/dev/ttyACM0 -b115200 -D -Uflash:w:$(pwd)/build/PanTiltController.ino.hex:i",
    "test:firmware": "g++ -std=c++17 -I./tests -I./firmware/PanTiltController tests/test_firmware.cpp firmware/PanTiltController/MotionController.cpp firmware/PanTiltController/SensorManager.cpp firmware/PanTiltController/CommandParser.cpp -o test_runner && ./test_runner"
  },
  "keywords": [
    "pan-tilt",
    "stepper",
    "arduino",
    "stp-drv-6575",
    "alt-azimuth",
    "web-serial",
    "threejs"
  ],
  "author": "",
  "license": "MIT"
}

